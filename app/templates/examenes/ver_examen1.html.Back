{% extends "base.html" %}

{% block title %}{{ examen.titulo }} | SistPROF{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="mb-4">
        <a href="{{ url_for('examen.listar_examenes') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>{{ examen.titulo }}</h3>
        </div>
        <div class="card-body">
            <p>{{ examen.descripcion }}</p>
            <div class="row">
                <div class="col-md-3"><strong>Tiempo:</strong> {{ examen.tiempo_limite_minutos }} min</div>
                <div class="col-md-3"><strong>Preguntas:</strong> {{ examen.contenido_json|length }}</div>
                <div class="col-md-3"><strong>Fecha:</strong> {{ examen.fecha_creacion.strftime('%d/%m/%Y') }}</div>
                <div class="col-md-3"><strong>Materia:</strong> {{ examen.materia.nombre }}</div>
            </div>
        </div>
    </div>

    <h4 class="mb-4">Preguntas del Examen</h4>
    
    {% for pregunta in examen.contenido_json %}
    <div class="card mb-3">
        <div class="card-header">
            <strong>Pregunta {{ pregunta.numero }}</strong>
            <span class="badge bg-{% if pregunta.dificultad == 'baja' %}success{% elif pregunta.dificultad == 'media' %}warning{% else %}danger{% endif %} float-end">
                {{ pregunta.dificultad|capitalize }}
            </span>
        </div>
        <div class="card-body">
            <p><strong>{{ pregunta.texto }}</strong></p>
            <div class="row">
                {% for letra, opcion in pregunta.opciones.items() %}
                <div class="col-md-6 mb-2">
                    <div class="alert alert-{% if letra == pregunta.respuesta_correcta %}success{% else %}light{% endif %} py-2">
                        <strong>{{ letra }})</strong> {{ opcion }}
                        {% if letra == pregunta.respuesta_correcta %}✓{% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% if pregunta.explicacion %}
            <div class="alert alert-info mt-2">
                <small><strong>Retroalimentación:</strong> {{ pregunta.explicacion }}</small>
            </div>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}